# Supabase (required for auth, catalog, and trends)
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional storefront contact / canonical origin.
# NEXT_PUBLIC_SUPPORT_WHATSAPP: digits only, with country code (e.g. 57...).
#   When unset or invalid, WhatsApp support buttons are hidden.
# NEXT_PUBLIC_SITE_URL: canonical storefront origin used in recovery/referral links.
#   Falls back to window.location.origin in the browser.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SITE_URL=

# Provider token encryption (server-only). 64 hex chars recommended:
#   openssl rand -hex 32
PROVIDER_TOKEN_ENCRYPTION_KEY=

# Mercado Libre OAuth app (developers.mercadolibre.com.co)
# Redirect URI must match exactly what is registered in the app, e.g.
#   https://your-domain/api/admin/providers/meli/callback
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://localhost:3000/api/admin/providers/meli/callback
# Optional comma-separated MELI category ids for best-seller tracking (max 5).
# When empty, the top-level MCO categories are discovered automatically.
MELI_CATEGORY_IDS=

# AliExpress Affiliate (open.aliexpress.com) — server-only secrets
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# AliExpress Dropshipping (DS) app — SEPARATE app registration from the
# Affiliate credentials above; do not reuse ALIEXPRESS_* keys here.
# If the rotated DS secret was previously stored as ALIEXPRESS_APP_SECRET in
# your hosting provider, rename that entry to ALIEXPRESS_DS_APP_SECRET and keep
# ALIEXPRESS_APP_SECRET for the affiliate app only.
# Redirect URI must match the callback_url registered in the DS app console:
#   https://your-domain/api/admin/providers/aliexpress-ds/callback
ALIEXPRESS_DS_APP_KEY=
ALIEXPRESS_DS_APP_SECRET=
ALIEXPRESS_DS_REDIRECT_URI=http://localhost:3000/api/admin/providers/aliexpress-ds/callback

# CJ Dropshipping — server-only API key (token is stored encrypted server-side)
CJ_API_KEY=

# Wompi payments — server-only. Private key signs payment-link requests; the
# events secret verifies webhook checksums. Both required for checkout to be
# enabled. WOMPI_ENVIRONMENT defaults to sandbox; set to "production"
# explicitly to accept real charges (keys must be the prod_* pair).
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=sandbox

# Cron authentication — server-only. Vercel crons send this as a Bearer
# token to /api/cron/*. Required for the daily supplier-retry and tracking
# sync jobs; generate with: openssl rand -hex 32
CRON_SECRET=

# Resend transactional email — server-only. Optional: order confirmation is
# sent only after a verified payment; without these the order flow still
# works and the customer relies on the tracking page.
# RESEND_FROM_EMAIL must be a sender on a Resend-verified domain you own
# (a *.vercel.app domain cannot be verified).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
